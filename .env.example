# ============================================================
# 环境变量模板：复制为 backend/.env（或仓库根 .env）后填写真实值
#   PowerShell:  Copy-Item .env.example backend\.env
# .env 已被 .gitignore 排除，真实口令不会进仓库；本模板只提交键名。
# 生效优先级：进程环境变量 > .env > 代码默认值
#
# 三套环境（APP_ENV）：dev（本地，默认） | test（隔离预生产，非 fail-fast） | prod（生产，fail-fast）
# prod 下 config.validate_config 会对默认凭证 / root 账号 / 关认证 / 开调试 / CORS 全域名 /
# 会话 Cookie 非 Secure / 残留 API_ADMIN_TOKEN 等硬红线直接拒绝启动。
# ============================================================

# ---------------- MySQL ----------------
DB_HOST=127.0.0.1
DB_PORT=3306
# 生产禁用 root，须用最小权限专用账号（见 deploy/mysql_grants.sql）
DB_USER=root
# 本地演示默认 123456；真实口令写在这里，绝不写回 config.py / 提交仓库
DB_PASSWORD=
DB_NAME=student_behavior
DB_POOL_SIZE=10

# ---------------- 运行环境 ----------------
# dev | test | prod（prod 触发安全自检 fail-fast）
APP_ENV=dev
# 会话/加密种子，prod 必须注入随机长串：
#   python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# 调试开关，默认关；仅本地开发才建议 1（prod 开启会被拒绝启动）
FLASK_DEBUG=0
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# ---------------- 认证与会话（阶段 1：httpOnly Cookie 会话 + CSRF） ----------------
# 1=开启（默认）：除 /api/health 与 /api/auth/login|status 外所有接口需有效会话 Cookie；
# 写操作需 X-CSRF-Token 头。0 仅限非 prod 离线演示（prod 设 0 会被拒绝启动）。
AUTH_ENABLED=1
# 会话有效期（秒），默认 8 小时
SESSION_TTL=28800
# 会话 Cookie Secure：prod 强制 1（须 HTTPS），dev/test 默认 0 便于 http 联调
# SESSION_COOKIE_SECURE=0
# 登录失败限流：连续失败达阈值锁定账号一段时间（落库，多进程/重启仍生效）
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
# 审计日志保留天数（超期由 cli_users.py purge-audit 清理/匿名化）
AUDIT_RETENTION_DAYS=365
# 聚合统计最小群体规模：分组样本 < 该值合并为“其他”，防小样本反推个人
STATS_MIN_COHORT=5
# 首次启动引导管理员：仅用于创建第一个 system_admin；口令走环境变量、不进 Git。
# prod 下若既无 BOOTSTRAP_ADMIN_PASSWORD 又无已存在用户，会 fail-fast。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------- 跨域 ----------------
# 生产必须收敛为前端实际域名（多个逗号分隔）；prod 下留 * 会被拒绝启动
CORS_ORIGINS=*

# ---------------- 数据导入 / 异步作业（阶段 2） ----------------
# 单次 CSV 上传体积上限（字节），默认 50MB，超出 Flask 直接 413
MAX_UPLOAD_BYTES=52428800
JOB_DEFAULT_TIMEOUT=300
JOB_MAX_TIMEOUT=1800
# 是否在启动时拉起单机后台作业 worker；测试/多实例部署可用 0 关闭（见部署文档“并发与多进程”）
START_WORKER=1

# ---------------- 分析参数（可选） ----------------
CLUSTERING_K=4
CLUSTERING_CACHE_TTL=600
ANALYSIS_DEFAULT_DAYS=30
WARNING_TOP_N=10

# ---------------- 日志（阶段 6：结构化 + 脱敏） ----------------
# 级别：DEBUG/INFO/WARNING/ERROR（生产建议 INFO）
LOG_LEVEL=INFO
# 格式：json=一行一条 JSON（采集端友好，默认）；text=人类可读回退
LOG_FORMAT=json
