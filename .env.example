# ============================================================
# 环境变量模板：复制为仓库根 .env（或 backend/.env）后填写真实值
#   PowerShell:  Copy-Item .env.example .env
# .env 已被 .gitignore 排除，真实口令不会进仓库；本模板只提交键名。
# 生效优先级：进程环境变量 > .env > 代码默认值
# ============================================================

# ---------------- MySQL ----------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# 本地演示默认 123456；真实口令写在这里，不要写回 config.py
DB_PASSWORD=
DB_NAME=student_behavior

# ---------------- Flask ----------------
# 会话/加密种子，生产环境务必换成随机长字符串（如 python -c "import secrets;print(secrets.token_hex(32))"）
SECRET_KEY=
# 调试开关，默认 0（关）；本地开发才建议写 1
FLASK_DEBUG=1
# 环境标识：prod 时启动自检对默认凭证升级强告警（公网部署务必设 prod）
# APP_ENV=dev
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# ---------------- 登录守卫（轻量，单管理员账号） ----------------
# 1=开启（默认）：除 /api/health 与 /api/auth/login|status 外，所有接口需 Bearer token
# 0=关闭：退化为"仅写接口查 X-API-Token"的旧行为，只适合离线演示
AUTH_ENABLED=1
AUTH_USERNAME=admin
# 二选一：推荐只配哈希（生成命令见 README《登录与权限》），留哈希时下面明文行删除
AUTH_PASSWORD_HASH=
# 未配哈希时的回退口令，默认 admin123 仅限本地，公网必改
AUTH_PASSWORD=
# 登录态有效期（秒），默认 12 小时
# AUTH_TOKEN_TTL=43200

# ---------------- 安全 ----------------
# 非空时：作为脚本/定时任务的旁路凭证（X-API-Token 头，免登录可读写），
# 也可在 AUTH_ENABLED=0 时单独保护写接口；冒烟测试未配置时会自动临时注入
API_ADMIN_TOKEN=
# 生产应收敛为前端实际域名，多个用逗号分隔
CORS_ORIGINS=*

# ---------------- 分析参数（可选） ----------------
# CLUSTERING_K=4
# CLUSTERING_CACHE_TTL=600
# ANALYSIS_DEFAULT_DAYS=30
